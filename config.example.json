{
  "schema_version": 1,
  "node": {
    "id": "00000000-0000-4000-8000-000000000001",
    "name": "example-node"
  },
  "control": {
    "endpoint": "wss://origin.example.com/internal/agent/ws",
    "credential_file": "/etc/akastr-agent/identity.json"
  },
  "state_file": "/var/lib/akastr-agent/state.json",
  "recent_operation_limit": 64,
  "capabilities": {
    "ip_watch": {
      "enabled": true,
      "interval_seconds": 60,
      "observe_ipv6": false
    },
    "change_ip": {
      "enabled": false
    },
    "socks5": {
      "enabled": false
    },
    "ipquality_runner": {
      "enabled": false
    }
  }
}
